{
  "name": "@local/dsh-plugin-vix-dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "VIX market dashboard with indicator snapshots and action journal.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "undici": "^8.12.4",
    "zod": "^4.1.0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
